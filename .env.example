# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/velatrix_aos?schema=public"

# VELATRIX AOS V2: Banking-as-a-Service (BaaS) & Government Integration Config
# Provedor BaaS (ASAAS | STARK_BANK | CELCOIN)
BAAS_PROVIDER="ASAAS"
BAAS_API_KEY=""
BAAS_WEBHOOK_SECRET=""

# Cofre Criptográfico de Certificados A1 (AWS KMS ARN ou HashiCorp Vault)
VAULT_KMS_KEY_ID=""

# SERPRO / Receita Federal e-CAC API
SERPRO_API_KEY=""

# VELATRIX AOS AUTH & SECURITY CONFIG (P6)
# Segredo criptográfico HS256 da sessão (mínimo 32 bytes)
SESSION_SECRET=""

# Senha corporativa base para geração de hashes dos usuários seed (scrypt)
SEED_ADMIN_PASSWORD=""

# Segredo compartilhado HMAC-SHA256 para webhooks de ERP
ERP_WEBHOOK_SECRET=""

# Flag de desenvolvimento para permitir fallback de headers x-user-role / x-tenant-id (apenas se NODE_ENV !== 'production')
ALLOW_DEV_HEADERS=""

